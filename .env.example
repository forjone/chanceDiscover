# ── Database ─────────────────────────────────────────────
# Local file (default). For Turso, use libsql://<db>.turso.io
DATABASE_URL="file:./data/miner.db"
# Required only for remote Turso databases.
DATABASE_AUTH_TOKEN=""

# ── Trend signals (Phase 2) ──────────────────────────────
# YouTube Data API v3 key. When absent, trend momentum is
# derived from real review-volume trajectory instead of AI guessing.
YOUTUBE_API_KEY=""

# ── Collectors (Phase 1) ─────────────────────────────────
# Default storefront country for App Store RSS harvesting.
APPSTORE_COUNTRY="us"
